# ------------------------------------------------------------------------------
# AetherionConfig.cmake.in
# Generated by configure_package_config_file(); do not edit by hand.
# Consumers: find_package(Aetherion REQUIRED)
# ------------------------------------------------------------------------------

@PACKAGE_INIT@

# ── Eigen3 ────────────────────────────────────────────────────────────────────
# Prefer a system Eigen3 if already found; otherwise synthesise an INTERFACE
# target from the headers installed alongside Aetherion.
if(NOT TARGET Eigen3::Eigen)
  find_package(Eigen3 QUIET CONFIG)
  if(NOT Eigen3_FOUND)
    add_library(Eigen3::Eigen INTERFACE IMPORTED GLOBAL)
    target_include_directories(Eigen3::Eigen INTERFACE
      "${PACKAGE_PREFIX_DIR}/include")
  endif()
endif()

# ── CppAD ─────────────────────────────────────────────────────────────────────
# One path on every platform: FindCppAD.cmake is installed next to this file and
# builds the CppAD::cppad imported target from whatever prefix CppAD lives in --
# the consumer's own (vcpkg, distribution package, …) if there is one, otherwise
# the copy bundled with this installation.
if(NOT TARGET CppAD::cppad)
  set(_aetherion_saved_module_path "${CMAKE_MODULE_PATH}")
  set(_aetherion_saved_prefix_path "${CMAKE_PREFIX_PATH}")
  list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  list(APPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")

  find_package(CppAD MODULE REQUIRED)

  # Do not leak the search paths into the consuming project.
  set(CMAKE_MODULE_PATH "${_aetherion_saved_module_path}")
  set(CMAKE_PREFIX_PATH "${_aetherion_saved_prefix_path}")
  unset(_aetherion_saved_module_path)
  unset(_aetherion_saved_prefix_path)
endif()

# ── Aetherion targets (Aetherion::Aetherion, Aetherion::fmu4cpp_base, …) ─────
include("${CMAKE_CURRENT_LIST_DIR}/AetherionTargets.cmake")

# ── FMU generation helper (exposes generateFMU() to consumers) ────────────────
include("${CMAKE_CURRENT_LIST_DIR}/generate_fmu.cmake")

check_required_components(Aetherion)
