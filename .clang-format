---
# Aetherion C++ layout, enforced by the Clang-Format workflow (clang-format 18, .run-clang-format).
#
# Chosen to describe the code as it was written rather than impose a new style: 4-space indentation, `T* p`, function
# bodies on their own brace line, `if (`. The existing line breaks are kept (ColumnLimit 0: clang-format does not re-flow
# hand-wrapped statements), and so are hand-aligned trailing comments; includes and using-declarations are never
# reordered and comments never reflowed. Keep lines within 120 columns by hand.
BasedOnStyle: LLVM
Language: Cpp
Standard: c++20

IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
ColumnLimit: 0
AccessModifierOffset: -4
NamespaceIndentation: All
IndentCaseLabels: true
IndentPPDirectives: None

PointerAlignment: Left
DerivePointerAlignment: false
SpaceBeforeParens: ControlStatements
Cpp11BracedListStyle: false
AlignAfterOpenBracket: DontAlign
AlignConsecutiveAssignments:
  Enabled: false
AlignConsecutiveDeclarations:
  Enabled: false
AlignTrailingComments:
  Kind: Leave
SpacesBeforeTrailingComments: 1

SortIncludes: Never
SortUsingDeclarations: Never
ReflowComments: false
FixNamespaceComments: false
MaxEmptyLinesToKeep: 2
KeepEmptyLinesAtTheStartOfBlocks: true

AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortBlocksOnASingleLine: Always
AllowShortLambdasOnASingleLine: All

AlwaysBreakTemplateDeclarations: Yes
PackConstructorInitializers: Never
BreakConstructorInitializers: BeforeComma

BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: true
  AfterStruct: true
  AfterUnion: true
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: false
  AfterExternBlock: false
  AfterControlStatement: MultiLine
  BeforeCatch: false
  BeforeElse: false
  BeforeLambdaBody: false
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false
